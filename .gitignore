# Executables & Binaries
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
build/bin/
# wails writes <name>-res.syso next to the main package and deletes it after
# linking; an interrupted build leaves it behind as an untracked binary.
*.syso

# Dependency directories
vendor/

# Frontend temporary & generated build artifacts
node_modules/
frontend/node_modules/
frontend/dist/
*.md5
frontend/*.md5

# Go test & coverage binaries
*.test
*.out

# Editor / IDE configurations (Keep repository editor-agnostic)
.vscode/
.zed/
.idea/

# OS generated files
Thumbs.db
.DS_Store

# Local session context notes (keep out of repository)
CONTEXT.md
totalplug_context.md
